
/* ==================================
   PURPLE THEME + SMOOTH ANIMATIONS
   ================================== */

:root {
  --primary-50: #F8F4FF;
  --primary-100: #EDE7FF;
  --primary-500: #8B5CF6;
  --primary-600: #6B46C1;
  --primary-700: #553399;

  --accent-coral: #FF6B6B;
  --success-green: #10B981;
  --page-background: #F8F4FF;
  --card-background: #FFFFFF;
  --main-text: #2D1B69;
}

/* Smooth page appearance */
@keyframes pageFadeIn {
  from {
    opacity: 0;
    transform: translateY(12px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.main-content {
  animation: pageFadeIn 0.6s ease-out;
}

/* Hero banner */
.hero-banner {
  background: linear-gradient(
    135deg,
    #6B46C1,
    #8B5CF6,
    #C4B5FD
  );
  color: #FFFFFF;
  position: relative;
  overflow: hidden;
}

/* Soft floating decoration */
.hero-banner::after {
  content: "✦";
  position: absolute;
  right: 8%;
  top: 15%;
  font-size: 70px;
  color: rgba(255, 255, 255, 0.22);
  pointer-events: none;
  animation: gentleFloat 4s ease-in-out infinite;
}

@keyframes gentleFloat {
  0%, 100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-12px);
  }
}

/* Question paper cards */
.papers-grid .paper-card {
  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

@media (hover: hover) and (pointer: fine) {
  .papers-grid .paper-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(91, 58, 158, 0.14);
  }
}

/* Buttons */
.btn,
button {
  transition:
    background-color 0.2s ease,
    color 0.2s ease,
    transform 0.2s ease;
}

.btn-primary {
  background-color: var(--primary-600);
}

.btn-primary:hover {
  background-color: var(--primary-700);
}

/* Search inputs */
input,
select,
textarea {
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

input:focus,
select:focus,
textarea:focus {
  border-color: var(--primary-600);
  box-shadow: 0 0 0 3px rgba(107, 70, 193, 0.14);
  outline: none;
}

/* Respect reduced-motion preferences */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}
